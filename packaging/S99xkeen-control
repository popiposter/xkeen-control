#!/bin/sh
set -eu

BIN="${XKEEN_CONTROL_BIN:-/opt/sbin/xkeen-control}"
PIDFILE="${XKEEN_CONTROL_PIDFILE:-/opt/var/run/xkeen-control.pid}"
LOG="${XKEEN_CONTROL_LOG:-/tmp/xkeen-control.log}"
LISTEN_FILE="${XKEEN_CONTROL_LISTEN_FILE:-/opt/etc/xkeen-control/listen-address}"
if [ -n "${XKEEN_CONTROL_LISTEN:-}" ]; then
	LISTEN="$XKEEN_CONTROL_LISTEN"
elif [ -r "$LISTEN_FILE" ]; then
	LISTEN="$(sed -n '1p' "$LISTEN_FILE")"
else
	LISTEN="127.0.0.1:8787"
fi

pid_is_control() {
	pid="$1"
	ps w 2>/dev/null | awk -v wanted_pid="$pid" -v wanted_bin="$BIN" '$1 == wanted_pid && index($0, wanted_bin) { found = 1 } END { exit found ? 0 : 1 }'
}

read_pid() {
	[ -r "$PIDFILE" ] || return 1
	pid="$(cat "$PIDFILE" 2>/dev/null || true)"
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	pid_is_control "$pid"
}

start() {
	[ -x "$BIN" ] || { echo "xkeen-control binary is not installed: $BIN" >&2; return 1; }
	if read_pid; then
		echo "xkeen-control already running: $pid"
		return 0
	fi
	mkdir -p "$(dirname -- "$PIDFILE")"
	# Diagnostics are ephemeral and reset at service start; the Go process does
	# not write a request/access log.
	: > "$LOG"
	XKEEN_CONTROL_LISTEN="$LISTEN" nohup "$BIN" >> "$LOG" 2>&1 &
	child="$!"
	printf '%s\n' "$child" > "$PIDFILE"
	sleep 1
	if ! pid_is_control "$child"; then
		rm -f "$PIDFILE"
		echo "xkeen-control failed to start; see $LOG" >&2
		return 1
	fi
	echo "xkeen-control started: $child"
}

stop() {
	if ! read_pid; then
		rm -f "$PIDFILE"
		echo "xkeen-control is not running"
		return 0
	fi
	kill -TERM "$pid" 2>/dev/null || true
	i=0
	while pid_is_control "$pid"; do
		i=$((i + 1))
		[ "$i" -ge 10 ] && break
		sleep 1
	done
	if pid_is_control "$pid"; then
		kill -KILL "$pid" 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
	echo "xkeen-control stopped"
}

status() {
	if read_pid; then
		echo "xkeen-control running: $pid"
		return 0
	fi
	echo "xkeen-control stopped"
	return 1
}

case "${1:-status}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status) status ;;
	*) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
