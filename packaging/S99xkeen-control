#!/bin/sh
set -eu

# Installed Entware tools (not firmware BusyBox applets) own native commands.
PATH="/opt/bin:/opt/sbin:${PATH:-/usr/sbin:/usr/bin:/sbin:/bin}"
export PATH

BIN="${XKEEN_CONTROL_BIN:-/opt/sbin/xkeen-control}"
PIDFILE="${XKEEN_CONTROL_PIDFILE:-/opt/var/run/xkeen-control.pid}"
LOG="${XKEEN_CONTROL_LOG:-/tmp/xkeen-control.log}"

pid_is_control() {
	pid="$1"
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ "$(readlink "/proc/$pid/exe" 2>/dev/null)" = "$BIN" ] || return 1
	# Only the no-argument daemon is a service process. version/setup/updater
	# CLI invocations must never be mistaken for it or killed by stop.
	[ -r "/proc/$pid/cmdline" ] || return 1
	tr '\000' '\n' < "/proc/$pid/cmdline" | awk -v bin="$BIN" 'NR == 1 { valid = ($0 == bin) } END { exit !(valid && NR == 1) }'
}

read_pid() {
	[ -r "$PIDFILE" ] || return 1
	pid="$(cat "$PIDFILE" 2>/dev/null || true)"
	case "$pid" in
		''|*[!0-9]*) return 1 ;;
	esac
	pid_is_control "$pid"
}

start() {
	[ -x "$BIN" ] || { echo "xkeen-control binary is not installed: $BIN" >&2; return 1; }
	# Go repeats this check while retaining its shared process lock for life.
	# The init check refuses incomplete setup before logs/PID/worker startup.
	"$BIN" setup guard || return 1
	if read_pid; then
		echo "xkeen-control already running: $pid"
		return 0
	fi
	mkdir -p "$(dirname -- "$PIDFILE")"
	# Diagnostics are ephemeral and reset at service start; the Go process does
	# not write a request/access log.
	: > "$LOG"
	# Go owns env -> fixed listener file -> default resolution. This init
	# script inherits a real external XKEEN_CONTROL_LISTEN override but never
	# manufactures ownership from the persisted listener file.
	nohup "$BIN" >> "$LOG" 2>&1 &
	child="$!"
	printf '%s\n' "$child" > "$PIDFILE" || return 1
	# Spawn acknowledgement only. The update owner independently verifies bounded
	# readiness, process identity and the complete installed generation.
	echo "xkeen-control spawned: $child"
}

stop() {
	if ! read_pid; then
		rm -f "$PIDFILE"
		echo "xkeen-control is not running"
		return 0
	fi
	kill -TERM "$pid" 2>/dev/null || true
	i=0
	while pid_is_control "$pid"; do
		i=$((i + 1))
		[ "$i" -ge 10 ] && break
		sleep 1
	done
	if pid_is_control "$pid"; then
		kill -KILL "$pid" 2>/dev/null || true
	fi
	rm -f "$PIDFILE"
	echo "xkeen-control stopped"
}

status() {
	if read_pid; then
		echo "xkeen-control running: $pid"
		return 0
	fi
	echo "xkeen-control stopped"
	return 1
}

case "${1:-status}" in
	start) start ;;
	stop) stop ;;
	restart) stop; start ;;
	status) status ;;
	*) echo "usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
