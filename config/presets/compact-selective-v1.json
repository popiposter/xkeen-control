      },
      {
        "type": "field",
        "inboundTag": [
          "redirect",
          "tproxy",
          "socks"
        ],
        "domain": [
          "ext:geosite_refilter.dat:REFILTER"
        ],
        "balancerTag": "bal-proxy"
      },
      {
        "type": "field",
        "inboundTag": [
          "redirect",
          "tproxy",
          "socks"
        ],
        "ip": [
          "ext:geoip_refilter.dat:refilter"
        ],
        "balancerTag": "bal-proxy"
      },
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "direct",
        "inboundTag": [
          "redirect",
          "tproxy",
          "socks"
        ]
      }
    ]
