# Copy this placeholder to an operator-owned path outside every repository
# checkout. Repo-local .env.keenetic files are ignored only as defense-in-depth.
KEENETIC_SSH_HOST=router.example
KEENETIC_SSH_PORT=22
KEENETIC_SSH_USER=root

# Configure at least one authentication method. Key-based access is preferred.
# KEENETIC_SSH_IDENTITY_FILE=C:/Users/operator/.ssh/xkeen-control-keenetic
# KEENETIC_SSH_PASSWORD=replace-locally
