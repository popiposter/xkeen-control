FROM golang:1.27-bookworm AS go-toolchain

FROM node:24-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/go/bin:/go/bin:$PATH \
    CGO_ENABLED=1 \
    GOTOOLCHAIN=local \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    npm_config_update_notifier=false \
    npm_config_fund=false

COPY --from=go-toolchain /usr/local/go /usr/local/go

RUN apt-get update \
    && apt-get install --yes --no-install-recommends \
        bash \
        build-essential \
        ca-certificates \
        git \
        jq \
        openssh-client \
        qemu-user \
    && rm -rf /var/lib/apt/lists/*

# Browser and OS dependencies are image inputs, not per-test setup. Rebuilding
# this layer is required only when the pinned frontend dependency graph changes.
# Derive the temporary manifest from the lockfile root so script-only edits to
# package.json do not download Chromium again. Actual builds still use both files.
COPY web/package-lock.json /tmp/xkeen-playwright/
RUN cd /tmp/xkeen-playwright \
    && node -e 'const fs = require("fs"); fs.writeFileSync("package.json", JSON.stringify(require("./package-lock.json").packages[""]))' \
    && npm ci --ignore-scripts \
    && npx playwright install --with-deps chromium \
    && chmod -R a+rX "$PLAYWRIGHT_BROWSERS_PATH" \
    && rm -rf /tmp/xkeen-playwright

WORKDIR /workspace
