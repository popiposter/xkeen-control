#!/bin/sh
set -eu
set -f

# Fixed, purpose-built panel lifecycle helper. It accepts only install, adopt,
# rollback or rebind and has no arbitrary command, path, URL or file API. A /tmp-only
# root prefix exists solely for hermetic off-router fixtures.
TEST_MODE="${XKEEN_CONTROL_TEST_MODE:-0}"
ROOT_PREFIX="${XKEEN_CONTROL_TEST_ROOT:-}"
if [ "$TEST_MODE" = "1" ]; then
	case "$ROOT_PREFIX" in
		/tmp/*) ;;
		*) echo "ERROR: updater test root must be an absolute /tmp path" >&2; exit 1 ;;
	esac
else
	[ -z "$ROOT_PREFIX" ] || { echo "ERROR: updater test root is unavailable in production mode" >&2; exit 1; }
	ROOT_PREFIX=""
fi

BIN="${ROOT_PREFIX}/opt/sbin/xkeen-control"
INIT="${ROOT_PREFIX}/opt/etc/init.d/S99xkeen-control"
HELPER="${ROOT_PREFIX}/opt/libexec/xkeen-control-updater"
PREVIOUS="${ROOT_PREFIX}/opt/etc/xkeen-control/previous/panel"
CANDIDATE="${ROOT_PREFIX}/tmp/xkeen-control/panel-update"
TEMP="${ROOT_PREFIX}/tmp/xkeen-control/panel-update-rollback"
TEMP_HELPER_ABSENT="${TEMP}/.helper-absent"
STATE="${ROOT_PREFIX}/opt/etc/xkeen-control/state"
ACTIVE="$STATE/panel-update-active.json"
RESULT="$STATE/panel-update-result.json"
SETUP_LOCK="${ROOT_PREFIX}/opt/var/lock/xkeen-control/initial-setup.lock"
PIDFILE="${ROOT_PREFIX}/opt/var/run/xkeen-control.pid"
LISTEN_FILE="${ROOT_PREFIX}/opt/etc/xkeen-control/listen-address"
if [ -n "${XKEEN_CONTROL_LISTEN_FILE:-}" ]; then
	LISTEN_FILE="$XKEEN_CONTROL_LISTEN_FILE"
fi
NODE_REGISTRY="${ROOT_PREFIX}/opt/etc/xkeen-control/secrets/nodes.json"
NODE_OUTBOUNDS="${ROOT_PREFIX}/opt/etc/xray/configs/04_outbounds.json"
ADOPTION_RECOVERY="${STATE}/panel-adoption-recovery"
LISTENER_STAGING="${ROOT_PREFIX}/tmp/xkeen-control/panel-listener"
LISTENER_CANDIDATE="${LISTENER_STAGING}/candidate"
LISTENER_PREVIOUS="${LISTENER_STAGING}/previous"
LISTENER_PREVIOUS_ABSENT="${LISTENER_STAGING}/previous-absent"

fail() { echo "ERROR: panel updater rejected operation" >&2; exit 1; }
[ "$#" -eq 1 ] || fail
action="${1:-}"
case "$action" in install|adopt|rollback|rebind) ;; *) fail ;; esac

if [ "$TEST_MODE" = 1 ] && [ "${XKEEN_CONTROL_TEST_ARCH:-arm64}" != probe ]; then
	ARCHITECTURE="${XKEEN_CONTROL_TEST_ARCH:-arm64}"
else
	case "$(uname -m)" in
		aarch64|arm64) ARCHITECTURE=arm64 ;;
		mips|mipsel|mipsle)
			entware_architectures="$("${ROOT_PREFIX}/opt/bin/opkg" print-architecture)" || fail
			printf '%s\n' "$entware_architectures" | grep -Eq '^arch mipsel-3\.4(_kn)? [0-9]+$' || fail
			ARCHITECTURE=mipsle ;;
		*) fail ;;
	esac
fi
case "$ARCHITECTURE" in arm64|mipsle) ;; *) fail ;; esac
if [ "$action" = adopt ]; then [ "$ARCHITECTURE" = arm64 ] || fail; fi
BINARY_ASSET="xkeen-control-linux-$ARCHITECTURE"

valid_port() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

listener_url_for() {
	listen="$1"
	case "$listen" in
		\[*\]:*)
			host="${listen#\[}"
			host="${host%%\]*}"
			port="${listen##*:}"
			[ "[$host]:$port" = "$listen" ] || return 1
			valid_port "$port" || return 1
			host_lower="$(printf '%s' "$host" | tr 'A-F' 'a-f')"
			case "$host_lower" in ::1|fc*|fd*) ;; *) return 1 ;; esac
			case "$host_lower" in *[!0-9a-f:]*) return 1 ;; esac
			;;
		*:*)
			host="${listen%:*}"
			port="${listen##*:}"
			valid_port "$port" || return 1
			old_ifs="$IFS"
			IFS=.
			set -- $host
			IFS="$old_ifs"
			[ "$#" -eq 4 ] || return 1
			for octet in "$@"; do
				case "$octet" in ''|*[!0-9]*) return 1 ;; esac
				[ "$octet" -le 255 ] 2>/dev/null || return 1
			done
			first="$1"; second="$2"
			case "$first" in
				10|127) ;;
				192) [ "$second" -eq 168 ] || return 1 ;;
				172) [ "$second" -ge 16 ] && [ "$second" -le 31 ] || return 1 ;;
				*) return 1 ;;
			esac
			;;
		*) return 1 ;;
	esac
	printf 'http://%s/healthz\n' "$listen"
}

private_health_url() {
	listen="127.0.0.1:8787"
	if [ -n "${XKEEN_CONTROL_LISTEN:-}" ]; then
		listen="$XKEEN_CONTROL_LISTEN"
	elif [ -r "$LISTEN_FILE" ]; then
		listen="$(sed -n '1p' "$LISTEN_FILE" | tr -d '\r\n')"
	fi
	listener_url_for "$listen"
}

health() {
	command -v curl >/dev/null 2>&1 || return 1
	url="$(private_health_url)" || return 1
	curl --fail --silent --show-error --max-time 1 "$url" >/dev/null 2>&1
}

stop_panel() { "$INIT" stop >/dev/null 2>&1 || true; }
start_panel() { timeout -k 1 10 "$INIT" start 3>&- 4>&- >/dev/null 2>&1; }

flock_preflight() (
	command -v flock >/dev/null 2>&1 || return 1
	probe="$(mktemp /tmp/xkeen-flock-check.XXXXXX)" || return 1
	trap 'rm -f "$probe"' EXIT
	exec 3< "$probe" 4< "$probe" || return 1
	timeout -k 1 3 sh -c '
		flock -n -x 3 || exit 1
		if flock -n -s 4; then exit 1; fi
		flock -n -s 3 || exit 1
		flock -n -s 4 || exit 1
		if flock -n -x 4; then exit 1; fi'
)

# Select and exercise the same executable on both required object kinds before
# service shutdown. BusyBox sync without -f is not a durability substitute.
durability_preflight() {
	command -v timeout >/dev/null 2>&1 && timeout -k 1 1 true || {
		echo 'ERROR: bounded timeout -k support is required (install coreutils-timeout)' >&2
		return 1
	}
	flock_preflight || { echo 'ERROR: compatible flock descriptor locking is required' >&2; return 1; }
	SYNC="$(command -v sync)" || return 1
	if [ "$TEST_MODE" != 1 ] && [ -x /opt/bin/sync ]; then SYNC=/opt/bin/sync; fi
	"$SYNC" -f "${1:-$ACTIVE}" && "$SYNC" -f "${2:-$STATE}" || {
		echo 'ERROR: file and directory sync -f support is required (install coreutils-sync)' >&2
		return 1
	}
}

legacy_ready() {
	[ ! -e "$ACTIVE" ] && [ ! -L "$ACTIVE" ] || return 1
	if [ -e "$RESULT" ] || [ -L "$RESULT" ]; then
		[ -f "$RESULT" ] && [ ! -L "$RESULT" ] || return 1
		jq -e '(.phase=="installed-verified" and .verified==.candidate) or
		(.phase=="rolled-back-verified" and .verified==(if .action=="rollback" and .reason=="explicit-rollback" then .candidate else .previous end))' "$RESULT" >/dev/null || return 1
	fi
	durability_preflight "$BIN" "${BIN%/*}"
}

installed_digest() (
	set -- "$BIN" "$INIT" "$HELPER" "$STATE/installed-release.json"
	digest_lines=""
	for name in "$BINARY_ASSET" S99xkeen-control xkeen-control-updater installed-release.json; do
		[ -f "$1" ] && [ ! -L "$1" ] || exit 1
		[ "$(stat -c %u:%h "$1")" = 0:1 ] || exit 1
		mode=755; [ "$name" != installed-release.json ] || mode=600
		[ "$(stat -c %a "$1")" = "$mode" ] || exit 1
		sum="$(sha256sum "$1")" || exit 1
		digest_lines="${digest_lines}${sum%% *}  $name
"
		shift
	done
	printf '%s' "$digest_lines" | sha256sum | awk '{print $1}'
)

verify_previous() {
	[ "$(installed_digest)" = "$(jq -er .previousDigest "$ACTIVE")" ] || return 1
	jq -e --slurpfile marker "$STATE/installed-release.json" '.previous==$marker[0]' "$ACTIVE" >/dev/null || return 1
	verify_marker "$STATE/installed-release.json"
}

capture_intent() {
	[ "$(stat -c %u:%a:%h "$ACTIVE")" = 0:600:1 ] || return 1
	[ "$(stat -c %u:%a "$STATE")" = 0:700 ] || return 1
	jq -e --arg action "$action" --arg arch "$ARCHITECTURE" '
		.schemaVersion==1 and .action==$action and .architecture==$arch and .phase=="prepared" and
		(.operationId|test("^[0-9a-f]{32}$")) and (.manifestDigest|test("^[0-9a-f]{64}$")) and
		(.previousDigest|test("^[0-9a-f]{64}$")) and (.verified==null)' "$ACTIVE" >/dev/null || return 1
	intent_identity="$(stat -c %d:%i "$ACTIVE")" || return 1
	intent_digest="$(sha256sum "$ACTIVE")" || return 1
}

own_intent() {
	[ -f "$ACTIVE" ] && [ ! -L "$ACTIVE" ] &&
	[ "$(stat -c %d:%i "$ACTIVE")" = "$intent_identity" ] &&
	[ "$(sha256sum "$ACTIVE")" = "$intent_digest" ]
}

update_phase() (
	phase="$1"; reason="${2:-}"
	phase_input="$ACTIVE"
	[ ! -f "$RESULT" ] || phase_input="$RESULT"
	phase_temp="$(mktemp "$STATE/.update-phase.XXXXXX")" || return 1
	trap 'rm -f "$phase_temp"' EXIT
	jq --arg phase "$phase" --arg reason "$reason" --arg now "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
		'del(.verified) | .phase=$phase | .reason=$reason | .updatedAt=$now' "$phase_input" > "$phase_temp" || return 1
	commit_file "$phase_temp" "$RESULT" 600
)

update_terminal() {
	update_phase "$1" "${2:-}" || return 1
	terminal_temp="$(mktemp "$STATE/.update-terminal.XXXXXX")" || return 1
	jq --slurpfile marker "$STATE/installed-release.json" '.verified=$marker[0]' "$RESULT" > "$terminal_temp" || { rm -f "$terminal_temp"; return 1; }
	jq -e 'if .phase=="installed-verified" then .action=="install" and .verified==.candidate
		elif .phase=="rolled-back-verified" then .verified==(if .action=="rollback" and .reason=="explicit-rollback" then .candidate else .previous end)
		else false end' "$terminal_temp" >/dev/null || { rm -f "$terminal_temp"; return 1; }
	commit_file "$terminal_temp" "$RESULT" 600 || { rm -f "$terminal_temp"; return 1; }
	rm -f "$terminal_temp" || return 1
	own_intent || return 1
	rm -f "$ACTIVE" || return 1
	"${SYNC:-sync}" -f "$STATE" || return 1
}

update_exit() {
	if [ "${update_resolved:-0}" != 1 ]; then
		update_phase inspection-required "${update_reason:-unexpected-exit}" || true
	fi
}

verify_candidate_tuple() {
	[ "$(sha256sum "$CANDIDATE/release-manifest.json" | awk '{print $1}')" = "$(jq -r .manifestDigest "$ACTIVE")" ] || return 1
	for name in "$BINARY_ASSET" S99xkeen-control xkeen-control-updater install.sh; do
		[ -f "$CANDIDATE/$name" ] && [ ! -L "$CANDIDATE/$name" ] || return 1
		expected="$(jq -er --arg name "$name" '.artifacts[] | select(.name==$name) | .sha256' "$CANDIDATE/release-manifest.json")" || return 1
		[ "$(sha256sum "$CANDIDATE/$name" | awk '{print $1}')" = "$expected" ] || return 1
	done
}

update_lock() {
	if [ "$TEST_MODE" = 1 ]; then return 0; fi
	[ -f "$SETUP_LOCK" ] && [ ! -L "$SETUP_LOCK" ] || return 1
	[ ! -L "${SETUP_LOCK%/*}" ] && [ "$(stat -c %u:%a "${SETUP_LOCK%/*}")" = 0:700 ] || return 1
	[ "$(stat -c %a "$SETUP_LOCK")" = 600 ] && [ "$(stat -c %u "$SETUP_LOCK")" = 0 ] || return 1
	if [ "${XKEEN_CONTROL_UPDATE_LOCK_FD:-}" = 3 ] || [ "${update_lock_held:-0}" = 1 ]; then
		[ "$(stat -Lc %d:%i /proc/self/fd/3)" = "$(stat -c %d:%i "$SETUP_LOCK")" ] || return 1
	else
		exec 3< "$SETUP_LOCK" || return 1
	fi
	flock -n -x 3 || return 1
	[ "$(stat -Lc %d:%i /proc/self/fd/3)" = "$(stat -c %d:%i "$SETUP_LOCK")" ] || return 1
	update_lock_held=1
}

update_allow_daemon() {
	[ "$TEST_MODE" = 1 ] || flock -s 3
}

daemon_identity() {
	if [ "$TEST_MODE" = 1 ]; then printf 'fixture\n'; return 0; fi
	[ -f "$PIDFILE" ] && [ ! -L "$PIDFILE" ] || return 1
	pid="$(cat "$PIDFILE")" || return 1
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ "$(readlink "/proc/$pid/exe")" = "$BIN" ] || return 1
	tr '\000' '\n' < "/proc/$pid/cmdline" | awk -v bin="$BIN" 'NR == 1 { valid = ($0 == bin) } END { exit !(valid && NR == 1) }' || return 1
	start="$(sed 's/.*) //' "/proc/$pid/stat" | awk '{print $20}')" || return 1
	case "$start" in ''|*[!0-9]*) return 1 ;; esac
	printf '%s:%s\n' "$pid" "$start"
}

tuple_matches() {
	phase_dir="$1"
	cmp -s "$phase_dir/$BINARY_ASSET" "$BIN" && cmp -s "$phase_dir/S99xkeen-control" "$INIT" && \
		cmp -s "$phase_dir/xkeen-control-updater" "$HELPER" || return 1
	for installed in "$BIN" "$INIT" "$HELPER"; do
		[ ! -L "$installed" ] && [ "$(stat -c %a "$installed")" = 755 ] || return 1
	done
	verify_marker "$phase_dir/installed-release.json"
}

await_ready() {
	phase_dir="$1"
	ceiling=30; [ "$ARCHITECTURE" != mipsle ] || ceiling=60
	if [ -z "${readiness_deadline:-}" ]; then readiness_deadline=$(( $(date +%s) + ceiling )); fi
	previous_identity=""; stable=0
	while [ "$(date +%s)" -lt "$readiness_deadline" ]; do
		if ! identity="$(daemon_identity)"; then
			pid="$(cat "$PIDFILE" 2>/dev/null)"
			case "$pid" in ''|*[!0-9]*) update_reason=process-exited; return 1 ;; esac
			kill -0 "$pid" 2>/dev/null || { update_reason=process-exited; return 1; }
			stable=0; sleep 1; continue
		fi
		if health; then
			tuple_matches "$phase_dir" || { update_reason=identity-mismatch; return 1; }
			[ "$(daemon_identity)" = "$identity" ] || { update_reason=identity-mismatch; return 1; }
			[ "$(date +%s)" -lt "$readiness_deadline" ] || break
			if [ "$identity" = "$previous_identity" ]; then stable=$((stable + 1)); else stable=1; fi
			previous_identity="$identity"
			[ "$stable" -lt 2 ] || return 0
		else stable=0; fi
		sleep 1
	done
	update_reason=health-timeout
	return 1
}

begin_readiness() {
	ceiling=30; [ "$ARCHITECTURE" != mipsle ] || ceiling=60
	readiness_deadline=$(( $(date +%s) + ceiling ))
}

rebind_response_grace() {
	case "${XKEEN_CONTROL_HANDOFF_DELAY:-1}" in
		0) return 0 ;;
		1) sleep 1 ;;
		*) return 1 ;;
	esac
}

validate_listener_candidate() {
	path="$1"
	bounded_regular_file "$path" 256 || return 1
	first="$(sed -n '1p' "$path" | tr -d '\r\n')"
	second="$(sed -n '2p' "$path" | tr -d '\r\n')"
	[ -n "$first" ] && [ -z "$second" ] || return 1
	listener_url_for "$first" >/dev/null
}

# The legacy init script is the only lifecycle surface available before #2.
# Confirming that no process still has the fixed legacy binary in /proc is a
# state check, not a connection heuristic. If process inspection is
# unavailable or fails, the adoption handoff refuses to continue.
panel_running() {
	command -v awk >/dev/null 2>&1 || return 0
	command -v tr >/dev/null 2>&1 || return 0
	[ -d /proc ] || return 0
	process_seen=0
	inspection_failed=0
	panel_found=0
	set +f
	for process_dir in /proc/[0-9]*; do
		[ -d "$process_dir" ] || continue
		process_seen=1
		cmdline_inspected=0
		if [ -r "$process_dir/cmdline" ]; then
			cmdline_inspected=1
			if tr '\000' '\n' < "$process_dir/cmdline" | PANEL_BIN="$BIN" awk '
				$0 == ENVIRON["PANEL_BIN"] { found = 1 }
				END { if (found) exit 0; exit 1 }
			'; then
				panel_found=1
			fi
		fi
		if command -v readlink >/dev/null 2>&1 && [ -r "$process_dir/exe" ]; then
			executable="$(readlink "$process_dir/exe" 2>/dev/null || true)"
			if [ "$executable" = "$BIN" ]; then
				panel_found=1
			fi
		elif [ "$cmdline_inspected" -eq 0 ]; then
			inspection_failed=1
		fi
	done
	set -f
	[ "$process_seen" -eq 1 ] || return 0
	[ "$panel_found" -eq 1 ] && return 0
	[ "$inspection_failed" -eq 0 ] || return 0
	return 1
}

stop_panel_for_adoption() {
	"$INIT" stop >/dev/null 2>&1 || return 1
	panel_running && return 1
	return 0
}

bounded_regular_file() {
	path="$1"
	limit="$2"
	[ -f "$path" ] && [ ! -L "$path" ] || return 1
	size="$(wc -c < "$path" | tr -d '[:space:]')"
	case "$size" in ''|*[!0-9]*) return 1 ;; esac
	[ "$size" -le "$limit" ] 2>/dev/null
}

validate_node_pair() {
	binary="$1"
	registry="$2"
	outbounds="$3"
	rendered="$4"
	bounded_regular_file "$registry" 4194304 || return 1
	bounded_regular_file "$outbounds" 8388608 || return 1
	rm -f "$rendered"
	if ! XKEEN_NODES_PATH="$registry" XKEEN_ACTIVE_OUTBOUNDS="$outbounds" \
		"$binary" nodes validate >/dev/null 2>&1; then
		return 1
	fi
	if ! XKEEN_NODES_PATH="$registry" XKEEN_ACTIVE_OUTBOUNDS="$outbounds" \
		"$binary" nodes render --output "$rendered" >/dev/null 2>&1; then
		rm -f "$rendered"
		return 1
	fi
	if ! bounded_regular_file "$rendered" 8388608; then
		rm -f "$rendered"
		return 1
	fi
	rendered_hash="$(sha256sum "$rendered" | awk '{print $1}')"
	outbounds_hash="$(sha256sum "$outbounds" | awk '{print $1}')"
	rm -f "$rendered"
	[ "$rendered_hash" = "$outbounds_hash" ]
}

write_adoption_phase() {
	phase="$1"
	case "$phase" in prepared|handoff|restoring|recovered) ;; *) return 1 ;; esac
	[ -d "$ADOPTION_RECOVERY" ] && [ ! -L "$ADOPTION_RECOVERY" ] || return 1
	phase_source="$(mktemp "$ADOPTION_RECOVERY/.phase.XXXXXX")" || return 1
	printf '%s\n' "$phase" > "$phase_source" || { rm -f "$phase_source"; return 1; }
	commit_file "$phase_source" "$ADOPTION_RECOVERY/phase" 600 || { rm -f "$phase_source"; return 1; }
	rm -f "$phase_source" || return 1
}

read_adoption_phase() {
	[ -f "$ADOPTION_RECOVERY/phase" ] && [ ! -L "$ADOPTION_RECOVERY/phase" ] || return 1
	phase="$(sed -n '1p' "$ADOPTION_RECOVERY/phase" | tr -d '\r\n')"
	case "$phase" in prepared|handoff|restoring|recovered) printf '%s\n' "$phase" ;; *) return 1 ;; esac
}

prepare_adoption_recovery() {
	if [ -e "$ADOPTION_RECOVERY" ] || [ -L "$ADOPTION_RECOVERY" ]; then
		[ -d "$ADOPTION_RECOVERY" ] && [ ! -L "$ADOPTION_RECOVERY" ] || return 1
		phase="$(read_adoption_phase)" || return 1
		case "$phase" in prepared|handoff|restoring|recovered) ;; *) return 1 ;; esac
		bounded_regular_file "$ADOPTION_RECOVERY/nodes.json" 4194304 || return 1
		bounded_regular_file "$ADOPTION_RECOVERY/04_outbounds.json" 8388608 || return 1
		validate_node_pair "$CANDIDATE/$BINARY_ASSET" \
			"$ADOPTION_RECOVERY/nodes.json" "$ADOPTION_RECOVERY/04_outbounds.json" \
			"$ADOPTION_RECOVERY/.snapshot-rendered" || return 1
		return 0
	fi
	bounded_regular_file "$NODE_REGISTRY" 4194304 || return 1
	bounded_regular_file "$NODE_OUTBOUNDS" 8388608 || return 1
	mkdir -p "$ADOPTION_RECOVERY" || return 1
	chmod 700 "$ADOPTION_RECOVERY" || return 1
	if ! cp "$NODE_REGISTRY" "$ADOPTION_RECOVERY/nodes.json" || \
		! cp "$NODE_OUTBOUNDS" "$ADOPTION_RECOVERY/04_outbounds.json"; then
		rm -rf "$ADOPTION_RECOVERY"
		return 1
	fi
	chmod 600 "$ADOPTION_RECOVERY/nodes.json" "$ADOPTION_RECOVERY/04_outbounds.json" || return 1
	if ! validate_node_pair "$CANDIDATE/$BINARY_ASSET" \
		"$ADOPTION_RECOVERY/nodes.json" "$ADOPTION_RECOVERY/04_outbounds.json" \
		"$ADOPTION_RECOVERY/.snapshot-rendered"; then
		rm -rf "$ADOPTION_RECOVERY"
		return 1
	fi
	write_adoption_phase prepared
}

restore_node_file() {
	bounded_regular_file "$1" 8388608 || return 1
	commit_file "$1" "$2" 600
}

node_snapshot_matches_live() {
	bounded_regular_file "$NODE_REGISTRY" 4194304 || return 1
	bounded_regular_file "$NODE_OUTBOUNDS" 8388608 || return 1
	[ "$(sha256sum "$NODE_REGISTRY" | awk '{print $1}')" = "$(sha256sum "$ADOPTION_RECOVERY/nodes.json" | awk '{print $1}')" ] || return 1
	[ "$(sha256sum "$NODE_OUTBOUNDS" | awk '{print $1}')" = "$(sha256sum "$ADOPTION_RECOVERY/04_outbounds.json" | awk '{print $1}')" ]
}

reconcile_node_runtime() {
	XKEEN_NODES_PATH="$NODE_REGISTRY" XKEEN_ACTIVE_OUTBOUNDS="$NODE_OUTBOUNDS" \
		"$CANDIDATE/$BINARY_ASSET" nodes reconcile-runtime >/dev/null 2>&1
}

restore_node_snapshot() {
	write_adoption_phase restoring || return 1
	restore_node_file "$ADOPTION_RECOVERY/nodes.json" "$NODE_REGISTRY" || return 1
	restore_node_file "$ADOPTION_RECOVERY/04_outbounds.json" "$NODE_OUTBOUNDS" || return 1
	validate_node_pair "$CANDIDATE/$BINARY_ASSET" \
		"$NODE_REGISTRY" "$NODE_OUTBOUNDS" "$ADOPTION_RECOVERY/.current-rendered" || return 1
}

recover_node_state() {
	# Exact snapshot equality proves no persistent node generation crossed the
	# handoff. Otherwise a coherent pair is not enough: the legacy process may
	# have died after both writes but before Xray activation/readiness committed.
	if node_snapshot_matches_live; then
		write_adoption_phase recovered
		return 0
	fi
	if validate_node_pair "$CANDIDATE/$BINARY_ASSET" \
		"$NODE_REGISTRY" "$NODE_OUTBOUNDS" "$ADOPTION_RECOVERY/.current-rendered"; then
		if reconcile_node_runtime; then
			write_adoption_phase recovered
			return 0
		fi
		# The persistent pair is coherent but runtime proof failed. The attempted
		# reconciliation may itself have touched Xray, so restore the known
		# snapshot and explicitly converge runtime to it before panel replacement.
		restore_node_snapshot || return 1
		reconcile_node_runtime || return 1
		write_adoption_phase recovered
		return 0
	fi
	# An incoherent pair can only be before the legacy transaction's activation
	# phase: that phase starts after both persistent writes. Restore the known
	# snapshot; Xray is therefore still on that pre-activation generation.
	restore_node_snapshot || return 1
	write_adoption_phase recovered
}

clear_adoption_recovery() {
	if [ -e "$ADOPTION_RECOVERY" ] || [ -L "$ADOPTION_RECOVERY" ]; then
		[ -d "$ADOPTION_RECOVERY" ] && [ ! -L "$ADOPTION_RECOVERY" ] || return 1
		rm -rf "$ADOPTION_RECOVERY"
	fi
}

copy_panel() {
	commit_file "$1" "$2" 755
}

# Conditional callers disable errexit inside shell functions. Every operation
# therefore has its own checked result. Never reuse a predictable stale .new.
commit_file() (
	source="$1"
	destination="$2"
	mode="$3"
	[ -f "$source" ] && [ ! -L "$source" ] || return 1
	directory="$(dirname "$destination")" || return 1
	[ -d "$directory" ] && [ ! -L "$directory" ] || return 1
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		[ -f "$destination" ] && [ ! -L "$destination" ] || return 1
	fi
	temporary="$(mktemp "$directory/.panel-commit.XXXXXX")" || return 1
	trap 'rm -f "$temporary"' EXIT
	cp "$source" "$temporary" || return 1
	chmod "$mode" "$temporary" || return 1
	cmp -s "$source" "$temporary" || return 1
	[ "$(stat -c %a "$temporary")" = "$mode" ] || return 1
	"${SYNC:-sync}" -f "$temporary" || return 1
	mv -f "$temporary" "$destination" || return 1
	"${SYNC:-sync}" -f "$directory" || return 1
	cmp -s "$source" "$destination" || return 1
	[ "$(stat -c %a "$destination")" = "$mode" ] || return 1
)

snapshot_helper_state() {
	source="$1"
	destination_dir="$2"
	if [ -e "$source" ] || [ -L "$source" ]; then
		[ -f "$source" ] && [ -x "$source" ] && [ ! -L "$source" ] || return 1
		commit_file "$source" "$destination_dir/xkeen-control-updater" 755 || return 1
		rm -f "$destination_dir/.helper-absent" || return 1
	else
		: > "$destination_dir/.helper-absent" || return 1
		chmod 600 "$destination_dir/.helper-absent" || return 1
	fi
}

restore_helper_state() {
	source_dir="$1"
	destination="$2"
	if [ -f "$source_dir/.helper-absent" ]; then
		[ ! -e "$source_dir/xkeen-control-updater" ] && [ ! -L "$source_dir/xkeen-control-updater" ] || return 1
		if [ -e "$destination" ] || [ -L "$destination" ]; then
			[ -f "$destination" ] && [ ! -L "$destination" ] || return 1
			rm -f "$destination" || return 1
		fi
		return 0
	fi
	[ -f "$source_dir/xkeen-control-updater" ] && [ -x "$source_dir/xkeen-control-updater" ] && [ ! -L "$source_dir/xkeen-control-updater" ] || return 1
	copy_panel "$source_dir/xkeen-control-updater" "$destination"
}

snapshot_generation() {
	destination_dir="$1"
	[ -f "$BIN" ] && [ ! -L "$BIN" ] || return 1
	[ -f "$INIT" ] && [ ! -L "$INIT" ] || return 1
	commit_file "$BIN" "$destination_dir/$BINARY_ASSET" 755 || return 1
	commit_file "$INIT" "$destination_dir/S99xkeen-control" 755 || return 1
	snapshot_helper_state "$HELPER" "$destination_dir" || return 1
	if [ -e "$STATE/installed-release.json" ] || [ -L "$STATE/installed-release.json" ]; then
		[ -f "$STATE/installed-release.json" ] && [ ! -L "$STATE/installed-release.json" ] || return 1
		commit_file "$STATE/installed-release.json" "$destination_dir/installed-release.json" 600 || return 1
	fi
	return 0
}

write_marker_from() {
	source="$1"
	[ -f "$source" ] && [ ! -L "$source" ] || return 1
	mkdir -p "$STATE" || return 1
	[ ! -L "$STATE" ] || return 1
	chmod 700 "$STATE" || return 1
	commit_file "$source" "$STATE/installed-release.json" 600
}

restore_previous() {
	[ -f "$PREVIOUS/$BINARY_ASSET" ] || return 1
	copy_panel "$PREVIOUS/$BINARY_ASSET" "$BIN" || return 1
	copy_panel "$PREVIOUS/S99xkeen-control" "$INIT" || return 1
	restore_helper_state "$PREVIOUS" "$HELPER" || return 1
	if [ -f "$PREVIOUS/installed-release.json" ]; then
		write_marker_from "$PREVIOUS/installed-release.json" || return 1
	else
		rm -f "$STATE/installed-release.json" || return 1
	fi
}

verify_build() {
	version="$1"
	commit="$2"
	channel="$3"
	[ -n "$version" ] && [ -n "$commit" ] && [ -n "$channel" ] || return 1
	probe_seconds=5
	if [ -n "${readiness_deadline:-}" ]; then
		remaining=$((readiness_deadline - $(date +%s) - 1))
		[ "$remaining" -gt 0 ] || return 1
		[ "$remaining" -ge "$probe_seconds" ] || probe_seconds="$remaining"
	fi
	build_output="$(timeout -k 1 "$probe_seconds" "$BIN" version --json 2>/dev/null)" || return 1
	printf '%s\n' "$build_output" | jq -e -s --arg version "$version" --arg commit "$commit" --arg channel "$channel" \
		'length == 1 and (.[0] | .product == "xkeen-control" and .version == $version and .sourceCommit == $commit and .channel == $channel)' >/dev/null 2>&1
}

verify_marker() {
	marker="$1"
	[ -f "$marker" ] || return 0
	verify_build \
		"$(jq -r '.version' "$marker" 2>/dev/null || true)" \
		"$(jq -r '.sourceCommit' "$marker" 2>/dev/null || true)" \
		"$(jq -r '.channel' "$marker" 2>/dev/null || true)"
}

restore_current_marker() {
	if [ -f "$TEMP/current-installed-release.json" ]; then
		write_marker_from "$TEMP/current-installed-release.json"
	else
		rm -f "$STATE/installed-release.json"
	fi
}

install_listener_candidate() {
	commit_file "$1" "$LISTEN_FILE" 600
}

restore_listener_snapshot() {
	if [ -f "$LISTENER_PREVIOUS_ABSENT" ]; then
		[ "$(sed -n '1p' "$LISTENER_PREVIOUS_ABSENT" | tr -d '\r\n')" = "absent" ] || return 1
		[ ! -L "$LISTEN_FILE" ] || return 1
		rm -f "$LISTEN_FILE"
		return 0
	fi
	validate_listener_candidate "$LISTENER_PREVIOUS" || return 1
	install_listener_candidate "$LISTENER_PREVIOUS"
}

if [ "$action" = "rebind" ]; then
	legacy_ready || fail
	# An inherited environment bind is explicitly read-only. The broker will
	# reject a rebind before launch, and this helper keeps the same fail-closed
	# boundary if invoked outside that path.
	[ -z "${XKEEN_CONTROL_LISTEN:-}" ] || fail
	[ -d "$LISTENER_STAGING" ] && [ ! -L "$LISTENER_STAGING" ] || fail
	validate_listener_candidate "$LISTENER_CANDIDATE" || fail
	if [ -f "$LISTENER_PREVIOUS_ABSENT" ]; then
		[ ! -e "$LISTENER_PREVIOUS" ] && [ ! -L "$LISTENER_PREVIOUS" ] || fail
		[ "$(sed -n '1p' "$LISTENER_PREVIOUS_ABSENT" | tr -d '\r\n')" = "absent" ] || fail
	else
		[ ! -e "$LISTENER_PREVIOUS_ABSENT" ] && [ ! -L "$LISTENER_PREVIOUS_ABSENT" ] || fail
		validate_listener_candidate "$LISTENER_PREVIOUS" || fail
	fi
	rebind_response_grace || fail
	stop_panel
	if install_listener_candidate "$LISTENER_CANDIDATE" && start_panel && health; then
		rm -rf "$LISTENER_STAGING"
		exit 0
	fi
	stop_panel
	if restore_listener_snapshot && start_panel && health; then
		rm -rf "$LISTENER_STAGING"
		fail
	fi
	fail
fi

if [ "$action" = "adopt" ]; then
	legacy_ready || fail
	# Adoption is a separate action so the normal managed self-update path keeps
	# its existing coordinator-owned lifecycle. Only the signed installer can
	# place this fixed sentinel in the candidate boundary.
	[ -f "$CANDIDATE/.legacy-adoption" ] && [ ! -L "$CANDIDATE/.legacy-adoption" ] || fail
	[ -f "$CANDIDATE/$BINARY_ASSET" ] || fail
	[ -f "$CANDIDATE/S99xkeen-control" ] || fail
	[ -f "$CANDIDATE/xkeen-control-updater" ] || fail
	[ -f "$CANDIDATE/installed-release.json" ] || fail
	[ -f "$BIN" ] && [ ! -L "$BIN" ] || fail
	[ -f "$INIT" ] && [ ! -L "$INIT" ] || fail
	[ ! -e "$HELPER" ] && [ ! -L "$HELPER" ] || fail
	[ ! -e "$STATE/installed-release.json" ] && [ ! -L "$STATE/installed-release.json" ] || fail
	command -v jq >/dev/null 2>&1 || fail
	expected_version="$(jq -r '.version' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_commit="$(jq -r '.sourceCommit' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_channel="$(jq -r '.channel' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	[ -n "$expected_version" ] && [ -n "$expected_commit" ] && [ -n "$expected_channel" ] || fail

	adoption_recovery_exists=0
	if [ -e "$ADOPTION_RECOVERY" ] || [ -L "$ADOPTION_RECOVERY" ]; then
		adoption_recovery_exists=1
	fi
	if [ "$adoption_recovery_exists" -eq 0 ]; then
		rm -rf "$PREVIOUS"
		mkdir -p "$PREVIOUS"
		chmod 700 "$PREVIOUS"
		snapshot_generation "$PREVIOUS" || { rm -rf "$PREVIOUS"; fail; }
	else
		[ -f "$PREVIOUS/$BINARY_ASSET" ] || fail
		[ -f "$PREVIOUS/S99xkeen-control" ] || fail
	fi
	if ! prepare_adoption_recovery; then
		[ "$adoption_recovery_exists" -eq 1 ] || rm -rf "$PREVIOUS"
		fail
	fi
	adoption_phase="$(read_adoption_phase)" || fail
	case "$adoption_phase" in
		prepared|handoff|restoring)
			write_adoption_phase handoff || fail
			stop_panel_for_adoption || fail
			recover_node_state || fail
			;;
		recovered)
			if panel_running; then fail; fi
			recover_node_state || fail
			;;
		*) fail ;;
	esac

	copy_panel "$CANDIDATE/$BINARY_ASSET" "$BIN"
	copy_panel "$CANDIDATE/S99xkeen-control" "$INIT"
	copy_panel "$CANDIDATE/xkeen-control-updater" "$HELPER"
	if start_panel && health && verify_build "$expected_version" "$expected_commit" "$expected_channel" && write_marker_from "$CANDIDATE/installed-release.json"; then
		clear_adoption_recovery || fail
		rm -rf "$TEMP" "$CANDIDATE"
		exit 0
	fi
	stop_panel
	restore_previous || fail
	start_panel && health && verify_marker "$PREVIOUS/installed-release.json" || fail
	clear_adoption_recovery || fail
	rm -rf "$TEMP" "$CANDIDATE"
	fail
fi

if [ "$action" = "install" ]; then
	[ -f "$CANDIDATE/$BINARY_ASSET" ] || fail
	[ -f "$CANDIDATE/S99xkeen-control" ] || fail
	[ -f "$CANDIDATE/xkeen-control-updater" ] || fail
	[ -f "$CANDIDATE/installed-release.json" ] || fail
	command -v jq >/dev/null 2>&1 || fail
	expected_version="$(jq -r '.version' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_commit="$(jq -r '.sourceCommit' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_channel="$(jq -r '.channel' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	[ -f "$ACTIVE" ] && [ ! -L "$ACTIVE" ] || fail
	[ "$(stat -c %a "$ACTIVE")" = 600 ] || fail
	jq -e --arg version "$expected_version" --arg source "$expected_commit" --arg arch "$ARCHITECTURE" \
		'.schemaVersion==1 and .phase=="prepared" and .candidate.version==$version and .candidate.sourceCommit==$source and .architecture==$arch' "$ACTIVE" >/dev/null || fail
	verify_candidate_tuple || fail
	if [ -e "$RESULT" ] || [ -L "$RESULT" ]; then
		[ -f "$RESULT" ] && [ ! -L "$RESULT" ] || fail
		[ "$(jq -r .operationId "$RESULT")" != "$(jq -r .operationId "$ACTIVE")" ] || fail
	fi
	# Copy the reservation before any service/file mutation. Do not reuse a result
	# belonging to an older operation. EXIT/signal paths never perform rollback.
	durability_preflight && capture_intent || fail
commit_file "$ACTIVE" "$RESULT" 600 || fail
	update_resolved=0; update_reason=file-commit-failed
	trap update_exit EXIT
	trap 'update_reason=signal; exit 1' HUP INT TERM
	"${SYNC:-sync}" -f "$STATE" || fail
	update_phase stopping || fail
	rebind_response_grace || fail
	"$INIT" stop >/dev/null 2>&1 || fail
	update_lock && verify_previous || fail
	if [ -e "$BIN" ] || [ -L "$BIN" ]; then
		rm -rf "$PREVIOUS" || fail
		mkdir -p "$PREVIOUS" || fail
		chmod 700 "$PREVIOUS" || fail
		snapshot_generation "$PREVIOUS" || fail
	elif [ -e "$INIT" ] || [ -L "$INIT" ] || [ -e "$HELPER" ] || [ -L "$HELPER" ] || [ -e "$STATE/installed-release.json" ] || [ -L "$STATE/installed-release.json" ]; then
		fail
	fi
	update_phase committing || fail
	if verify_candidate_tuple && copy_panel "$CANDIDATE/$BINARY_ASSET" "$BIN" && \
		copy_panel "$CANDIDATE/S99xkeen-control" "$INIT" && \
		copy_panel "$CANDIDATE/xkeen-control-updater" "$HELPER" && \
		update_phase starting && update_allow_daemon && begin_readiness && start_panel && await_ready "$CANDIDATE" && \
		update_phase marker-commit && write_marker_from "$CANDIDATE/installed-release.json" && \
		cmp -s "$CANDIDATE/installed-release.json" "$STATE/installed-release.json" && await_ready "$CANDIDATE"; then
		update_terminal installed-verified || fail
		update_resolved=1
		rm -rf "$TEMP" "$CANDIDATE" || fail
		exit 0
	fi
	update_phase rollback "$update_reason" || fail
	"$INIT" stop >/dev/null 2>&1 || fail
	update_lock || fail
	if [ -f "$PREVIOUS/$BINARY_ASSET" ]; then
		restore_previous || fail
	else
		fail
	fi
	update_phase rollback-starting "$update_reason" || fail
	readiness_deadline=""
	update_allow_daemon && begin_readiness && start_panel && await_ready "$PREVIOUS" || fail
	cmp -s "$PREVIOUS/installed-release.json" "$STATE/installed-release.json" || fail
	update_terminal rolled-back-verified "$update_reason" || fail
	update_resolved=1
	rm -rf "$TEMP" "$CANDIDATE" || fail
	fail
fi

# Historical explicitly recorded helper-absent generation only. Managed rollback
# admission requires a full previous tuple and cannot enter this branch.
if [ -f "$PREVIOUS/.helper-absent" ]; then
 [ ! -e "$ACTIVE" ] && [ ! -L "$ACTIVE" ] || fail
 [ ! -e "$RESULT" ] && [ ! -L "$RESULT" ] || fail
[ -f "$PREVIOUS/$BINARY_ASSET" ] || fail
rm -rf "$TEMP"
mkdir -p "$TEMP"
chmod 700 "$TEMP"
snapshot_generation "$TEMP" || fail
mv "$TEMP/$BINARY_ASSET" "$TEMP/current-binary"
mv "$TEMP/S99xkeen-control" "$TEMP/current-init"
if [ -f "$TEMP/xkeen-control-updater" ]; then mv "$TEMP/xkeen-control-updater" "$TEMP/current-helper"; fi
if [ -f "$TEMP/installed-release.json" ]; then mv "$TEMP/installed-release.json" "$TEMP/current-installed-release.json"; fi
if [ -f "$TEMP_HELPER_ABSENT" ]; then mv "$TEMP_HELPER_ABSENT" "$TEMP/.current-helper-absent"; fi
stop_panel
restore_previous || fail
if start_panel && health && verify_marker "$PREVIOUS/installed-release.json"; then
	rm -rf "$PREVIOUS" "$TEMP"
	exit 0
fi
stop_panel
copy_panel "$TEMP/current-binary" "$BIN"
copy_panel "$TEMP/current-init" "$INIT"
if [ -f "$TEMP/current-helper" ]; then
	copy_panel "$TEMP/current-helper" "$HELPER"
else
	[ -f "$TEMP/.current-helper-absent" ] || fail
	if [ -e "$HELPER" ] || [ -L "$HELPER" ]; then
		[ -f "$HELPER" ] && [ ! -L "$HELPER" ] || fail
		rm -f "$HELPER"
	fi
fi
restore_current_marker
start_panel && health && verify_marker "$TEMP/current-installed-release.json" || fail
rm -rf "$TEMP"
fail
fi

[ -f "$PREVIOUS/$BINARY_ASSET" ] || fail
[ -f "$ACTIVE" ] && [ ! -L "$ACTIVE" ] || fail
jq -e '.phase=="prepared" and .action=="rollback"' "$ACTIVE" >/dev/null || fail
previous_digest="$( (cd "$PREVIOUS" && sha256sum "$BINARY_ASSET" S99xkeen-control xkeen-control-updater installed-release.json) | sha256sum | awk '{print $1}')" || fail
[ "$previous_digest" = "$(jq -r .manifestDigest "$ACTIVE")" ] || fail
if [ -f "$RESULT" ]; then [ "$(jq -r .operationId "$RESULT")" != "$(jq -r .operationId "$ACTIVE")" ] || fail; fi
durability_preflight && capture_intent || fail
commit_file "$ACTIVE" "$RESULT" 600 || fail
update_resolved=0; update_reason=rollback-failed
trap update_exit EXIT
trap 'update_reason=signal; exit 1' HUP INT TERM
update_phase stopping || fail
rebind_response_grace || fail
"$INIT" stop >/dev/null 2>&1 || fail
update_lock && verify_previous || fail
rm -rf "$TEMP"
mkdir -p "$TEMP"
chmod 700 "$TEMP"
snapshot_generation "$TEMP" || fail
update_phase committing || fail
restore_previous || fail
update_phase starting || fail
if update_allow_daemon && begin_readiness && start_panel && await_ready "$PREVIOUS" && cmp -s "$PREVIOUS/installed-release.json" "$STATE/installed-release.json"; then
	update_terminal rolled-back-verified explicit-rollback || fail
	update_resolved=1
	rm -rf "$PREVIOUS" "$TEMP"
	exit 0
fi
update_phase rollback "$update_reason" || fail
"$INIT" stop >/dev/null 2>&1 || fail
update_lock || fail
copy_panel "$TEMP/$BINARY_ASSET" "$BIN" || fail
copy_panel "$TEMP/S99xkeen-control" "$INIT" || fail
if [ -f "$TEMP/xkeen-control-updater" ]; then
	copy_panel "$TEMP/xkeen-control-updater" "$HELPER" || fail
else
	[ -f "$TEMP/.helper-absent" ] || fail
	if [ -e "$HELPER" ] || [ -L "$HELPER" ]; then
		[ -f "$HELPER" ] && [ ! -L "$HELPER" ] || fail
		rm -f "$HELPER"
	fi
fi
write_marker_from "$TEMP/installed-release.json" || fail
readiness_deadline=""
update_phase rollback-starting || fail
update_allow_daemon && begin_readiness && start_panel && await_ready "$TEMP" || fail
update_terminal rolled-back-verified rollback-failed-restored-current || fail
update_resolved=1
rm -rf "$TEMP"
fail
