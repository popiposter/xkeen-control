#!/bin/sh
set -eu
set -f

# Fixed, purpose-built panel lifecycle helper. It accepts only install, adopt
# or rollback and has no arbitrary command, path, URL or file API. A /tmp-only
# root prefix exists solely for hermetic off-router fixtures.
TEST_MODE="${XKEEN_CONTROL_TEST_MODE:-0}"
ROOT_PREFIX="${XKEEN_CONTROL_TEST_ROOT:-}"
if [ "$TEST_MODE" = "1" ]; then
	case "$ROOT_PREFIX" in
		/tmp/*) ;;
		*) echo "ERROR: updater test root must be an absolute /tmp path" >&2; exit 1 ;;
	esac
else
	[ -z "$ROOT_PREFIX" ] || { echo "ERROR: updater test root is unavailable in production mode" >&2; exit 1; }
	ROOT_PREFIX=""
fi

BIN="${ROOT_PREFIX}/opt/sbin/xkeen-control"
INIT="${ROOT_PREFIX}/opt/etc/init.d/S99xkeen-control"
HELPER="${ROOT_PREFIX}/opt/libexec/xkeen-control-updater"
PREVIOUS="${ROOT_PREFIX}/opt/etc/xkeen-control/previous/panel"
CANDIDATE="${ROOT_PREFIX}/tmp/xkeen-control/panel-update"
TEMP="${ROOT_PREFIX}/tmp/xkeen-control/panel-update-rollback"
TEMP_HELPER_ABSENT="${TEMP}/.helper-absent"
STATE="${ROOT_PREFIX}/opt/etc/xkeen-control/state"
LISTEN_FILE="${ROOT_PREFIX}/opt/etc/xkeen-control/listen-address"
NODE_REGISTRY="${ROOT_PREFIX}/opt/etc/xkeen-control/secrets/nodes.json"
NODE_OUTBOUNDS="${ROOT_PREFIX}/opt/etc/xray/configs/04_outbounds.json"
ADOPTION_RECOVERY="${STATE}/panel-adoption-recovery"

fail() { echo "ERROR: panel updater rejected operation" >&2; exit 1; }
action="${1:-}"
case "$action" in install|adopt|rollback) ;; *) fail ;; esac

valid_port() {
	case "$1" in ''|*[!0-9]*) return 1 ;; esac
	[ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null
}

private_health_url() {
	listen="127.0.0.1:8787"
	if [ -r "$LISTEN_FILE" ]; then
		listen="$(sed -n '1p' "$LISTEN_FILE" | tr -d '\r\n')"
	fi
	case "$listen" in
		\[*\]:*)
			host="${listen#\[}"
			host="${host%%\]*}"
			port="${listen##*:}"
			[ "[$host]:$port" = "$listen" ] || return 1
			valid_port "$port" || return 1
			host_lower="$(printf '%s' "$host" | tr 'A-F' 'a-f')"
			case "$host_lower" in ::1|fc*|fd*) ;; *) return 1 ;; esac
			case "$host_lower" in *[!0-9a-f:]*) return 1 ;; esac
			;;
		*:*)
			host="${listen%:*}"
			port="${listen##*:}"
			valid_port "$port" || return 1
			old_ifs="$IFS"
			IFS=.
			set -- $host
			IFS="$old_ifs"
			[ "$#" -eq 4 ] || return 1
			for octet in "$@"; do
				case "$octet" in ''|*[!0-9]*) return 1 ;; esac
				[ "$octet" -le 255 ] 2>/dev/null || return 1
			done
			first="$1"; second="$2"
			case "$first" in
				10|127) ;;
				192) [ "$second" -eq 168 ] || return 1 ;;
				172) [ "$second" -ge 16 ] && [ "$second" -le 31 ] || return 1 ;;
				*) return 1 ;;
			esac
			;;
		*) return 1 ;;
	esac
	printf 'http://%s/healthz\n' "$listen"
}

health() {
	command -v curl >/dev/null 2>&1 || return 1
	url="$(private_health_url)" || return 1
	curl --fail --silent --show-error --max-time 10 "$url" >/dev/null 2>&1
}

stop_panel() { "$INIT" stop >/dev/null 2>&1 || true; }
start_panel() { "$INIT" start >/dev/null 2>&1; }

# The legacy init script is the only lifecycle surface available before #2.
# Confirming that no process still has the fixed legacy binary in /proc is a
# state check, not a connection heuristic. If process inspection is
# unavailable or fails, the adoption handoff refuses to continue.
panel_running() {
	command -v awk >/dev/null 2>&1 || return 0
	command -v tr >/dev/null 2>&1 || return 0
	[ -d /proc ] || return 0
	process_seen=0
	inspection_failed=0
	panel_found=0
	set +f
	for process_dir in /proc/[0-9]*; do
		[ -d "$process_dir" ] || continue
		process_seen=1
		cmdline_inspected=0
		if [ -r "$process_dir/cmdline" ]; then
			cmdline_inspected=1
			if tr '\000' '\n' < "$process_dir/cmdline" | PANEL_BIN="$BIN" awk '
				$0 == ENVIRON["PANEL_BIN"] { found = 1 }
				END { if (found) exit 0; exit 1 }
			'; then
				panel_found=1
			fi
		fi
		if command -v readlink >/dev/null 2>&1 && [ -r "$process_dir/exe" ]; then
			executable="$(readlink "$process_dir/exe" 2>/dev/null || true)"
			if [ "$executable" = "$BIN" ]; then
				panel_found=1
			fi
		elif [ "$cmdline_inspected" -eq 0 ]; then
			inspection_failed=1
		fi
	done
	set -f
	[ "$process_seen" -eq 1 ] || return 0
	[ "$panel_found" -eq 1 ] && return 0
	[ "$inspection_failed" -eq 0 ] || return 0
	return 1
}

stop_panel_for_adoption() {
	"$INIT" stop >/dev/null 2>&1 || return 1
	panel_running && return 1
	return 0
}

bounded_regular_file() {
	path="$1"
	limit="$2"
	[ -f "$path" ] && [ ! -L "$path" ] || return 1
	size="$(wc -c < "$path" | tr -d '[:space:]')"
	case "$size" in ''|*[!0-9]*) return 1 ;; esac
	[ "$size" -le "$limit" ] 2>/dev/null
}

validate_node_pair() {
	binary="$1"
	registry="$2"
	outbounds="$3"
	rendered="$4"
	bounded_regular_file "$registry" 4194304 || return 1
	bounded_regular_file "$outbounds" 8388608 || return 1
	rm -f "$rendered"
	if ! XKEEN_NODES_PATH="$registry" XKEEN_ACTIVE_OUTBOUNDS="$outbounds" \
		"$binary" nodes validate >/dev/null 2>&1; then
		return 1
	fi
	if ! XKEEN_NODES_PATH="$registry" XKEEN_ACTIVE_OUTBOUNDS="$outbounds" \
		"$binary" nodes render --output "$rendered" >/dev/null 2>&1; then
		rm -f "$rendered"
		return 1
	fi
	if ! bounded_regular_file "$rendered" 8388608; then
		rm -f "$rendered"
		return 1
	fi
	rendered_hash="$(sha256sum "$rendered" | awk '{print $1}')"
	outbounds_hash="$(sha256sum "$outbounds" | awk '{print $1}')"
	rm -f "$rendered"
	[ "$rendered_hash" = "$outbounds_hash" ]
}

write_adoption_phase() {
	phase="$1"
	case "$phase" in prepared|handoff|restoring|recovered) ;; *) return 1 ;; esac
	[ -d "$ADOPTION_RECOVERY" ] && [ ! -L "$ADOPTION_RECOVERY" ] || return 1
	printf '%s\n' "$phase" > "$ADOPTION_RECOVERY/.phase.new"
	chmod 600 "$ADOPTION_RECOVERY/.phase.new"
	mv -f "$ADOPTION_RECOVERY/.phase.new" "$ADOPTION_RECOVERY/phase"
}

read_adoption_phase() {
	[ -f "$ADOPTION_RECOVERY/phase" ] && [ ! -L "$ADOPTION_RECOVERY/phase" ] || return 1
	phase="$(sed -n '1p' "$ADOPTION_RECOVERY/phase" | tr -d '\r\n')"
	case "$phase" in prepared|handoff|restoring|recovered) printf '%s\n' "$phase" ;; *) return 1 ;; esac
}

prepare_adoption_recovery() {
	if [ -e "$ADOPTION_RECOVERY" ] || [ -L "$ADOPTION_RECOVERY" ]; then
		[ -d "$ADOPTION_RECOVERY" ] && [ ! -L "$ADOPTION_RECOVERY" ] || return 1
		phase="$(read_adoption_phase)" || return 1
		case "$phase" in prepared|handoff|restoring|recovered) ;; *) return 1 ;; esac
		bounded_regular_file "$ADOPTION_RECOVERY/nodes.json" 4194304 || return 1
		bounded_regular_file "$ADOPTION_RECOVERY/04_outbounds.json" 8388608 || return 1
		validate_node_pair "$CANDIDATE/xkeen-control-linux-arm64" \
			"$ADOPTION_RECOVERY/nodes.json" "$ADOPTION_RECOVERY/04_outbounds.json" \
			"$ADOPTION_RECOVERY/.snapshot-rendered" || return 1
		return 0
	fi
	bounded_regular_file "$NODE_REGISTRY" 4194304 || return 1
	bounded_regular_file "$NODE_OUTBOUNDS" 8388608 || return 1
	mkdir -p "$ADOPTION_RECOVERY"
	chmod 700 "$ADOPTION_RECOVERY"
	if ! cp "$NODE_REGISTRY" "$ADOPTION_RECOVERY/nodes.json" || \
		! cp "$NODE_OUTBOUNDS" "$ADOPTION_RECOVERY/04_outbounds.json"; then
		rm -rf "$ADOPTION_RECOVERY"
		return 1
	fi
	chmod 600 "$ADOPTION_RECOVERY/nodes.json" "$ADOPTION_RECOVERY/04_outbounds.json"
	if ! validate_node_pair "$CANDIDATE/xkeen-control-linux-arm64" \
		"$ADOPTION_RECOVERY/nodes.json" "$ADOPTION_RECOVERY/04_outbounds.json" \
		"$ADOPTION_RECOVERY/.snapshot-rendered"; then
		rm -rf "$ADOPTION_RECOVERY"
		return 1
	fi
	write_adoption_phase prepared
}

restore_node_file() {
	source="$1"
	destination="$2"
	temporary="${destination}.adoption-recovery.new"
	bounded_regular_file "$source" 8388608 || return 1
	[ -d "$(dirname "$destination")" ] || return 1
	if [ -e "$destination" ] || [ -L "$destination" ]; then
		[ -f "$destination" ] && [ ! -L "$destination" ] || return 1
	fi
	if [ -e "$temporary" ] || [ -L "$temporary" ]; then
		[ ! -L "$temporary" ] || return 1
		rm -f "$temporary"
	fi
	cp "$source" "$temporary"
	chmod 600 "$temporary"
	mv -f "$temporary" "$destination"
}

restore_node_snapshot() {
	write_adoption_phase restoring || return 1
	restore_node_file "$ADOPTION_RECOVERY/nodes.json" "$NODE_REGISTRY" || return 1
	restore_node_file "$ADOPTION_RECOVERY/04_outbounds.json" "$NODE_OUTBOUNDS" || return 1
	validate_node_pair "$CANDIDATE/xkeen-control-linux-arm64" \
		"$NODE_REGISTRY" "$NODE_OUTBOUNDS" "$ADOPTION_RECOVERY/.current-rendered" || return 1
	write_adoption_phase recovered
}

recover_node_state() {
	if validate_node_pair "$CANDIDATE/xkeen-control-linux-arm64" \
		"$NODE_REGISTRY" "$NODE_OUTBOUNDS" "$ADOPTION_RECOVERY/.current-rendered"; then
		write_adoption_phase recovered
		return 0
	fi
	restore_node_snapshot
}

clear_adoption_recovery() {
	if [ -e "$ADOPTION_RECOVERY" ] || [ -L "$ADOPTION_RECOVERY" ]; then
		[ -d "$ADOPTION_RECOVERY" ] && [ ! -L "$ADOPTION_RECOVERY" ] || return 1
		rm -rf "$ADOPTION_RECOVERY"
	fi
}

copy_panel() {
	source="$1"
	destination="$2"
	[ -f "$source" ] || fail
	cp "$source" "$destination.new"
	chmod 755 "$destination.new"
	mv -f "$destination.new" "$destination"
}

snapshot_helper_state() {
	source="$1"
	destination_dir="$2"
	if [ -e "$source" ] || [ -L "$source" ]; then
		[ -f "$source" ] && [ -x "$source" ] && [ ! -L "$source" ] || return 1
		cp "$source" "$destination_dir/xkeen-control-updater"
		chmod 755 "$destination_dir/xkeen-control-updater"
		rm -f "$destination_dir/.helper-absent"
	else
		: > "$destination_dir/.helper-absent"
		chmod 600 "$destination_dir/.helper-absent"
	fi
}

restore_helper_state() {
	source_dir="$1"
	destination="$2"
	if [ -f "$source_dir/.helper-absent" ]; then
		[ ! -e "$source_dir/xkeen-control-updater" ] && [ ! -L "$source_dir/xkeen-control-updater" ] || return 1
		if [ -e "$destination" ] || [ -L "$destination" ]; then
			[ -f "$destination" ] && [ ! -L "$destination" ] || return 1
			rm -f "$destination" || return 1
		fi
		return 0
	fi
	[ -f "$source_dir/xkeen-control-updater" ] && [ -x "$source_dir/xkeen-control-updater" ] && [ ! -L "$source_dir/xkeen-control-updater" ] || return 1
	copy_panel "$source_dir/xkeen-control-updater" "$destination"
}

snapshot_generation() {
	destination_dir="$1"
	[ -f "$BIN" ] && [ ! -L "$BIN" ] || return 1
	[ -f "$INIT" ] && [ ! -L "$INIT" ] || return 1
	cp "$BIN" "$destination_dir/xkeen-control-linux-arm64"
	cp "$INIT" "$destination_dir/S99xkeen-control"
	snapshot_helper_state "$HELPER" "$destination_dir" || return 1
	if [ -e "$STATE/installed-release.json" ] || [ -L "$STATE/installed-release.json" ]; then
		[ -f "$STATE/installed-release.json" ] && [ ! -L "$STATE/installed-release.json" ] || return 1
		cp "$STATE/installed-release.json" "$destination_dir/installed-release.json"
		chmod 600 "$destination_dir/installed-release.json"
	fi
	chmod 755 "$destination_dir/xkeen-control-linux-arm64" "$destination_dir/S99xkeen-control"
}

write_marker_from() {
	source="$1"
	[ -f "$source" ] || return 1
	mkdir -p "$STATE"
	chmod 700 "$STATE"
	cp "$source" "$STATE/.installed-release.json.new"
	chmod 600 "$STATE/.installed-release.json.new"
	mv -f "$STATE/.installed-release.json.new" "$STATE/installed-release.json"
}

restore_previous() {
	[ -f "$PREVIOUS/xkeen-control-linux-arm64" ] || return 1
	copy_panel "$PREVIOUS/xkeen-control-linux-arm64" "$BIN"
	copy_panel "$PREVIOUS/S99xkeen-control" "$INIT"
	restore_helper_state "$PREVIOUS" "$HELPER" || return 1
	if [ -f "$PREVIOUS/installed-release.json" ]; then
		write_marker_from "$PREVIOUS/installed-release.json"
	else
		rm -f "$STATE/installed-release.json"
	fi
}

verify_build() {
	version="$1"
	commit="$2"
	channel="$3"
	[ -n "$version" ] && [ -n "$commit" ] && [ -n "$channel" ] || return 1
	"$BIN" version --json 2>/dev/null | jq -e --arg version "$version" --arg commit "$commit" --arg channel "$channel" \
		'.product == "xkeen-control" and .version == $version and .sourceCommit == $commit and .channel == $channel' >/dev/null 2>&1
}

verify_marker() {
	marker="$1"
	[ -f "$marker" ] || return 0
	verify_build \
		"$(jq -r '.version' "$marker" 2>/dev/null || true)" \
		"$(jq -r '.sourceCommit' "$marker" 2>/dev/null || true)" \
		"$(jq -r '.channel' "$marker" 2>/dev/null || true)"
}

restore_current_marker() {
	if [ -f "$TEMP/current-installed-release.json" ]; then
		write_marker_from "$TEMP/current-installed-release.json"
	else
		rm -f "$STATE/installed-release.json"
	fi
}

if [ "$action" = "adopt" ]; then
	# Adoption is a separate action so the normal managed self-update path keeps
	# its existing coordinator-owned lifecycle. Only the signed installer can
	# place this fixed sentinel in the candidate boundary.
	[ -f "$CANDIDATE/.legacy-adoption" ] && [ ! -L "$CANDIDATE/.legacy-adoption" ] || fail
	[ -f "$CANDIDATE/xkeen-control-linux-arm64" ] || fail
	[ -f "$CANDIDATE/S99xkeen-control" ] || fail
	[ -f "$CANDIDATE/xkeen-control-updater" ] || fail
	[ -f "$CANDIDATE/installed-release.json" ] || fail
	[ -f "$BIN" ] && [ ! -L "$BIN" ] || fail
	[ -f "$INIT" ] && [ ! -L "$INIT" ] || fail
	[ ! -e "$HELPER" ] && [ ! -L "$HELPER" ] || fail
	[ ! -e "$STATE/installed-release.json" ] && [ ! -L "$STATE/installed-release.json" ] || fail
	command -v jq >/dev/null 2>&1 || fail
	expected_version="$(jq -r '.version' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_commit="$(jq -r '.sourceCommit' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_channel="$(jq -r '.channel' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	[ -n "$expected_version" ] && [ -n "$expected_commit" ] && [ -n "$expected_channel" ] || fail

	adoption_recovery_exists=0
	if [ -e "$ADOPTION_RECOVERY" ] || [ -L "$ADOPTION_RECOVERY" ]; then
		adoption_recovery_exists=1
	fi
	if [ "$adoption_recovery_exists" -eq 0 ]; then
		rm -rf "$PREVIOUS"
		mkdir -p "$PREVIOUS"
		chmod 700 "$PREVIOUS"
		snapshot_generation "$PREVIOUS" || { rm -rf "$PREVIOUS"; fail; }
	else
		[ -f "$PREVIOUS/xkeen-control-linux-arm64" ] || fail
		[ -f "$PREVIOUS/S99xkeen-control" ] || fail
	fi
	if ! prepare_adoption_recovery; then
		[ "$adoption_recovery_exists" -eq 1 ] || rm -rf "$PREVIOUS"
		fail
	fi
	adoption_phase="$(read_adoption_phase)" || fail
	case "$adoption_phase" in
		prepared|handoff|restoring)
			write_adoption_phase handoff || fail
			stop_panel_for_adoption || fail
			recover_node_state || fail
			;;
		recovered)
			if panel_running; then fail; fi
			recover_node_state || fail
			;;
		*) fail ;;
	esac

	copy_panel "$CANDIDATE/xkeen-control-linux-arm64" "$BIN"
	copy_panel "$CANDIDATE/S99xkeen-control" "$INIT"
	copy_panel "$CANDIDATE/xkeen-control-updater" "$HELPER"
	if start_panel && health && verify_build "$expected_version" "$expected_commit" "$expected_channel" && write_marker_from "$CANDIDATE/installed-release.json"; then
		clear_adoption_recovery || fail
		rm -rf "$TEMP" "$CANDIDATE"
		exit 0
	fi
	stop_panel
	restore_previous || fail
	start_panel && health && verify_marker "$PREVIOUS/installed-release.json" || fail
	clear_adoption_recovery || fail
	rm -rf "$TEMP" "$CANDIDATE"
	fail
fi

if [ "$action" = "install" ]; then
	[ -f "$CANDIDATE/xkeen-control-linux-arm64" ] || fail
	[ -f "$CANDIDATE/S99xkeen-control" ] || fail
	[ -f "$CANDIDATE/xkeen-control-updater" ] || fail
	[ -f "$CANDIDATE/installed-release.json" ] || fail
	command -v jq >/dev/null 2>&1 || fail
	expected_version="$(jq -r '.version' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_commit="$(jq -r '.sourceCommit' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	expected_channel="$(jq -r '.channel' "$CANDIDATE/installed-release.json" 2>/dev/null || true)"
	if [ -e "$BIN" ] || [ -L "$BIN" ]; then
		rm -rf "$PREVIOUS"
		mkdir -p "$PREVIOUS"
		chmod 700 "$PREVIOUS"
		snapshot_generation "$PREVIOUS" || { rm -rf "$PREVIOUS"; fail; }
	elif [ -e "$INIT" ] || [ -L "$INIT" ] || [ -e "$HELPER" ] || [ -L "$HELPER" ] || [ -e "$STATE/installed-release.json" ] || [ -L "$STATE/installed-release.json" ]; then
		fail
	fi
	stop_panel
	copy_panel "$CANDIDATE/xkeen-control-linux-arm64" "$BIN"
	copy_panel "$CANDIDATE/S99xkeen-control" "$INIT"
	copy_panel "$CANDIDATE/xkeen-control-updater" "$HELPER"
	if start_panel && health && verify_build "$expected_version" "$expected_commit" "$expected_channel" && write_marker_from "$CANDIDATE/installed-release.json"; then
		rm -rf "$TEMP" "$CANDIDATE"
		exit 0
	fi
	stop_panel
	if [ -f "$PREVIOUS/xkeen-control-linux-arm64" ]; then
		restore_previous || { rm -rf "$TEMP" "$CANDIDATE"; fail; }
	else
		rm -f "$BIN" "$INIT" "$HELPER" "$STATE/installed-release.json"
		rm -rf "$TEMP" "$CANDIDATE"
		fail
	fi
	start_panel && health && verify_marker "$PREVIOUS/installed-release.json" || fail
	rm -rf "$TEMP" "$CANDIDATE"
	fail
fi

[ -f "$PREVIOUS/xkeen-control-linux-arm64" ] || fail
rm -rf "$TEMP"
mkdir -p "$TEMP"
chmod 700 "$TEMP"
snapshot_generation "$TEMP" || fail
mv "$TEMP/xkeen-control-linux-arm64" "$TEMP/current-binary"
mv "$TEMP/S99xkeen-control" "$TEMP/current-init"
if [ -f "$TEMP/xkeen-control-updater" ]; then mv "$TEMP/xkeen-control-updater" "$TEMP/current-helper"; fi
if [ -f "$TEMP/installed-release.json" ]; then mv "$TEMP/installed-release.json" "$TEMP/current-installed-release.json"; fi
if [ -f "$TEMP_HELPER_ABSENT" ]; then mv "$TEMP_HELPER_ABSENT" "$TEMP/.current-helper-absent"; fi
stop_panel
restore_previous || fail
if start_panel && health && verify_marker "$PREVIOUS/installed-release.json"; then
	rm -rf "$PREVIOUS" "$TEMP"
	exit 0
fi
stop_panel
copy_panel "$TEMP/current-binary" "$BIN"
copy_panel "$TEMP/current-init" "$INIT"
if [ -f "$TEMP/current-helper" ]; then
	copy_panel "$TEMP/current-helper" "$HELPER"
else
	[ -f "$TEMP/.current-helper-absent" ] || fail
	if [ -e "$HELPER" ] || [ -L "$HELPER" ]; then
		[ -f "$HELPER" ] && [ ! -L "$HELPER" ] || fail
		rm -f "$HELPER"
	fi
fi
restore_current_marker
start_panel && health && verify_marker "$TEMP/current-installed-release.json" || fail
rm -rf "$TEMP"
fail
